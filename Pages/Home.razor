    private record Annot(string Clock, string Text, string? Dur, double TimeMin);

    private static bool HasAnnotations(JsonElement raw) =>
        raw.TryGetProperty("annotations", out var a) && a.ValueKind == JsonValueKind.Array && a.GetArrayLength() > 0;

    private IEnumerable<Annot> Annotations(JsonElement raw)
    {
        var list = new List<Annot>();
        if (!raw.TryGetProperty("annotations", out var arr) || arr.ValueKind != JsonValueKind.Array) return list;
        var inv = CultureInfo.InvariantCulture;
        TryClock(raw, "session_start", out var baseDt);
        foreach (var a in arr.EnumerateArray())
        {
            double tmin = a.TryGetProperty("time_min", out var tm) && tm.ValueKind == JsonValueKind.Number ? tm.GetDouble() : 0;
            string text = a.TryGetProperty("text", out var tx) && tx.ValueKind == JsonValueKind.String ? tx.GetString()! : "";
            string? dur = a.TryGetProperty("duration_s", out var dv) && dv.ValueKind == JsonValueKind.Number
                ? dv.GetDouble().ToString("0.#", inv) + " s" : null;
            string clock = baseDt != default
                ? baseDt.AddMinutes(tmin).ToString("HH:mm:ss", inv)
                : tmin.ToString("0.0", inv) + " min";
            list.Add(new Annot(clock, text, dur, tmin));
        }
        return list;
    }

    private object[] AnnotationMarkers(JsonElement raw) =>
        Annotations(raw).Select(a => (object)new { x = a.TimeMin, color = "--ink-3" }).ToArray();

    private string LocalizeMsg(string s)
    {
        if (L.Lang != "es" || string.IsNullOrEmpty(s)) return s;
        System.Text.RegularExpressions.Match m;
        m = System.Text.RegularExpressions.Regex.Match(s, @"^induction not recorded: the recording starts with the composite already below (.+)$");
        if (m.Success) return $"inducción no registrada: la grabación empieza con el compuesto ya por debajo de {m.Groups[1].Value}";
        m = System.Text.RegularExpressions.Regex.Match(s, @"^emergence not detected: the recording ends before a sustained rise above (.+)$");
        if (m.Success) return $"emergencia no detectada: la grabación termina antes de un aumento sostenido por encima de {m.Groups[1].Value}";
        m = System.Text.RegularExpressions.Regex.Match(s, @"^no sustained period \((.+) min\) below (.+)$");
        if (m.Success) return $"sin periodo sostenido ({m.Groups[1].Value} min) por debajo de {m.Groups[2].Value}";
        if (s == "refinement left no usable window") return "el refinamiento no dejó una ventana utilizable";
        m = System.Text.RegularExpressions.Regex.Match(s, @"^maintenance window (.+) min is shorter than (.+) min$");
        if (m.Success) return $"la ventana de mantenimiento {m.Groups[1].Value} min es menor que {m.Groups[2].Value} min";
        m = System.Text.RegularExpressions.Regex.Match(s, @"^signal gap of (.+) s inside the window \(limit (.+) s\)$");
        if (m.Success) return $"hueco de señal de {m.Groups[1].Value} s dentro de la ventana (límite {m.Groups[2].Value} s)";
        if (s == "no maintenance detected") return "no se detectó mantenimiento";
        m = System.Text.RegularExpressions.Regex.Match(s, @"^(.*): (.+) % of samples at the device limits \(bad signal\)$");
        if (m.Success) return $"{m.Groups[1].Value}: {m.Groups[2].Value} % de las muestras en los límites del equipo (mala señal)";
        m = System.Text.RegularExpressions.Regex.Match(s, @"^sampling rate (.+) Hz differs from the session's (.+) Hz$");
        if (m.Success) return $"la frecuencia de muestreo {m.Groups[1].Value} Hz difiere de la de la sesión {m.Groups[2].Value} Hz";
        return s;
    }

