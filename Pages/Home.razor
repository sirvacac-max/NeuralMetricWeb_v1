    private string DeviceMedian(JsonElement raw, string key)
    {
        if (!raw.TryGetProperty("device", out var d) || !d.TryGetProperty(key, out var arr) || arr.ValueKind != JsonValueKind.Array)
            return "\u2014";
        var vals = arr.EnumerateArray().Where(e => e.ValueKind == JsonValueKind.Number).Select(e => e.GetDouble()).OrderBy(v => v).ToList();
        if (vals.Count == 0) return "\u2014";
        double med = vals.Count % 2 == 1 ? vals[vals.Count / 2] : (vals[vals.Count / 2 - 1] + vals[vals.Count / 2]) / 2;
        return med.ToString("0.#", CultureInfo.InvariantCulture);
    }

    private readonly record struct QcComp(string Ecr, string Efr, string Etr);
    private QcComp? QcComposition(JsonElement raw)
    {
        if (!raw.TryGetProperty("qc_composition", out var q) || q.ValueKind != JsonValueKind.Object) return null;
        var inv = CultureInfo.InvariantCulture;
        string f(string k) => q.TryGetProperty(k, out var v) && v.ValueKind == JsonValueKind.Number
            ? v.GetDouble().ToString("0.#", inv) : "—";
        return new QcComp(f("eCR_pct"), f("eFR_pct"), f("eTR_pct"));
    }

