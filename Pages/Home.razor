    private bool HasQualityConcern(JsonElement raw) => QualityNotes(raw).Any();

    private IEnumerable<string> QualityNotes(JsonElement raw)
    {
        var notes = new List<string>();
        if (!raw.TryGetProperty("quality", out var q) || q.ValueKind != JsonValueKind.Object) return notes;
        var inv = CultureInfo.InvariantCulture;
        if (q.TryGetProperty("resolution_changed", out var rc) && rc.ValueKind == JsonValueKind.True)
        {
            var vals = q.TryGetProperty("resolution_values_uv", out var rv) && rv.ValueKind == JsonValueKind.Array
                ? string.Join(" \u2192 ", rv.EnumerateArray().Select(e => e.GetDouble().ToString("0.###", inv)))
                : "";
            notes.Add(string.Format(L["Recording resolution changed between files ({0} µV/step); absolute band power (µV²) may not be comparable across the session."], vals));
        }
        if (q.TryGetProperty("fs_changed", out var fc) && fc.ValueKind == JsonValueKind.True)
            notes.Add(L["The sampling rate changes between files in this recording."]);
        if (q.TryGetProperty("files_excluded", out var fe) && fe.ValueKind == JsonValueKind.Number && fe.GetInt32() > 0)
            notes.Add(string.Format(L["{0} file(s) were excluded (different sampling rate or unreadable)."], fe.GetInt32()));
        if (q.TryGetProperty("max_clipped_pct", out var mc) && mc.ValueKind == JsonValueKind.Number && mc.GetDouble() > 2.0)
            notes.Add(string.Format(L["Up to {0}% of samples reached the amplifier limits (possible electrode lead-off or clipping)."], mc.GetDouble().ToString("0.#", inv)));
        if (q.TryGetProperty("blocks_dropped", out var bd) && bd.ValueKind == JsonValueKind.Number && bd.GetInt32() > 0)
            notes.Add(string.Format(L["{0} segment(s) were dropped as sensor-off (electrode lead-off)."], bd.GetInt32()));
        if (q.TryGetProperty("channel_advice", out var ca) && ca.ValueKind == JsonValueKind.Object)
        {
            string frm = ca.TryGetProperty("from", out var cf) && cf.ValueKind == JsonValueKind.String ? cf.GetString()! : "";
            string to2 = ca.TryGetProperty("to", out var ct) && ct.ValueKind == JsonValueKind.String ? ct.GetString()! : "";
            double fp = ca.TryGetProperty("from_pct", out var fpp) && fpp.ValueKind == JsonValueKind.Number ? fpp.GetDouble() : 0;
            double tp = ca.TryGetProperty("to_pct", out var tpp) && tpp.ValueKind == JsonValueKind.Number ? tpp.GetDouble() : 0;
            notes.Add(string.Format(L["Channel {0} is {1}% clipped; the ipsilateral channel {2} is only {3}% — consider switching to it."], frm, fp.ToString("0.#", inv), to2, tp.ToString("0.#", inv)));
        }
        if (q.TryGetProperty("low_fs", out var lf) && lf.ValueKind == JsonValueKind.True)
        {
            double fsHz = q.TryGetProperty("low_fs_hz", out var lfh) && lfh.ValueKind == JsonValueKind.Number ? lfh.GetDouble() : 0;
            double hiHz = q.TryGetProperty("band_hi_hz", out var bh) && bh.ValueKind == JsonValueKind.Number ? bh.GetDouble() : 0;
            notes.Add(string.Format(L["Sampling rate {0} Hz is low (Nyquist {1} Hz): the analysis band is limited to {2} Hz — high-frequency content and the pEEG composite may be unreliable."],
                fsHz.ToString("0.#", inv), (fsHz / 2).ToString("0.#", inv), hiHz.ToString("0.#", inv)));
        }
        bool feedChecked = false, feedFlag = false;
        if (raw.TryGetProperty("feed_check", out var fcx) && fcx.ValueKind == JsonValueKind.Object)
        {
            feedChecked = fcx.TryGetProperty("checked", out var fck) && fck.ValueKind == JsonValueKind.True;
            if (fcx.TryGetProperty("seams", out var fseams) && fseams.ValueKind == JsonValueKind.Array)
            {
                foreach (var sm in fseams.EnumerateArray())
                {
                    if (sm.ValueKind != JsonValueKind.Object) continue;
                    feedFlag = true;
                    string ff = sm.TryGetProperty("file", out var sf) && sf.ValueKind == JsonValueKind.String ? sf.GetString()! : "";
                    double cm = sm.TryGetProperty("claimed_min", out var scm) && scm.ValueKind == JsonValueKind.Number ? scm.GetDouble() : 0;
                    double km = sm.TryGetProperty("clock_min", out var skm) && skm.ValueKind == JsonValueKind.Number ? skm.GetDouble() : 0;
                    notes.Add(string.Format(L["Possible feed / sampling-rate change: '{0}' stores {1} min of data but the next file starts {2} min later - a reliable frequency axis requires a constant feed."], ff, cm.ToString("0.#", inv), km.ToString("0.#", inv)));
                }
            }
        }

        if (raw.TryGetProperty("qc_flags", out var qf) && qf.ValueKind == JsonValueKind.Object)
        {
            if (!(feedChecked && !feedFlag) && qf.TryGetProperty("sweep_step", out var sw) && sw.ValueKind == JsonValueKind.Object)
            {
                double at = sw.TryGetProperty("at_min", out var a0) && a0.ValueKind == JsonValueKind.Number ? a0.GetDouble() : 0;
                double fr = sw.TryGetProperty("from_hz", out var f0) && f0.ValueKind == JsonValueKind.Number ? f0.GetDouble() : 0;
                double to = sw.TryGetProperty("to_hz", out var t0) && t0.ValueKind == JsonValueKind.Number ? t0.GetDouble() : 0;
                notes.Add(string.Format(L["Possible sweep-speed change near {0} min (dominant frequency {1}→{2} Hz): the frequency axis may be unreliable there — verify the monitor sweep speed."], at.ToString("0.#", inv), fr.ToString("0.#", inv), to.ToString("0.#", inv)));
            }
            if (qf.TryGetProperty("clip", out var cl) && cl.ValueKind == JsonValueKind.Object
                && cl.TryGetProperty("high", out var ch) && ch.ValueKind == JsonValueKind.True)
            {
                int over = cl.TryGetProperty("epochs_over_pct", out var eo) && eo.ValueKind == JsonValueKind.Number ? eo.GetInt32() : 0;
                double mx = cl.TryGetProperty("max_epoch_pct", out var mp) && mp.ValueKind == JsonValueKind.Number ? mp.GetDouble() : 0;
                double th = cl.TryGetProperty("thresh_pct", out var tp) && tp.ValueKind == JsonValueKind.Number ? tp.GetDouble() : 25;
                notes.Add(string.Format(L["{0} one-minute epoch(s) exceed {1}% clipped samples (up to {2}%); clipped segments are excluded from analysis."], over, th.ToString("0", inv), mx.ToString("0.#", inv)));
            }
            if (qf.TryGetProperty("quant", out var qn) && qn.ValueKind == JsonValueKind.Object
                && qn.TryGetProperty("coarse", out var qcf) && qcf.ValueKind == JsonValueKind.True)
            {
                double st = qn.TryGetProperty("step_uv", out var su) && su.ValueKind == JsonValueKind.Number ? su.GetDouble() : 0;
                notes.Add(string.Format(L["Coarse amplitude quantization (~{0} µV steps): high-frequency and beta-band power may be inflated."], st.ToString("0.##", inv)));
            }
            if (qf.TryGetProperty("resolution_change", out var rcc) && rcc.ValueKind == JsonValueKind.Object)
            {
                double rat = rcc.TryGetProperty("at_min", out var ra0) && ra0.ValueKind == JsonValueKind.Number ? ra0.GetDouble() : 0;
                double rsb = rcc.TryGetProperty("step_before_uv", out var rb0) && rb0.ValueKind == JsonValueKind.Number ? rb0.GetDouble() : 0;
                double rsa = rcc.TryGetProperty("step_after_uv", out var ra2) && ra2.ValueKind == JsonValueKind.Number ? ra2.GetDouble() : 0;
                notes.Add(string.Format(L["Possible vertical-resolution change near {0} min (amplitude step {1}→{2} µV): absolute band power may not be comparable across that point."], rat.ToString("0.#", inv), rsb.ToString("0.##", inv), rsa.ToString("0.##", inv)));
            }
            if (qf.TryGetProperty("prefilter", out var pf) && pf.ValueKind == JsonValueKind.Object
                && pf.TryGetProperty("prefiltered", out var pfd) && pfd.ValueKind == JsonValueKind.True)
            {
                double hc = pf.TryGetProperty("hp_cutoff_hz", out var hcx) && hcx.ValueKind == JsonValueKind.Number ? hcx.GetDouble() : 0;
                notes.Add(string.Format(L["The monitor appears to high-pass the signal (slow activity attenuated below ~{0} Hz): delta-band power and depth estimates may be underread."], hc.ToString("0.#", inv)));
            }
        }
        if (raw.TryGetProperty("bsr_adaptive", out var ba) && ba.ValueKind == JsonValueKind.Object
            && ba.TryGetProperty("diverges", out var bad) && bad.ValueKind == JsonValueKind.True)
        {
            double af = ba.TryGetProperty("bsr_pct", out var bap) && bap.ValueKind == JsonValueKind.Number ? bap.GetDouble() : 0;
            double nf = ba.TryGetProperty("noise_floor_uv", out var bnf) && bnf.ValueKind == JsonValueKind.Number ? bnf.GetDouble() : 0;
            notes.Add(string.Format(L["Noise-adaptive BSR ({0}%) differs from the fixed-threshold BSR because the noise floor is elevated (~{1} µV): interpret burst suppression together with signal quality."], af.ToString("0.#", inv), nf.ToString("0.#", inv)));
        }
        if (raw.TryGetProperty("gaps", out var gps) && gps.ValueKind == JsonValueKind.Array && gps.GetArrayLength() > 0)
        {
            int ng = gps.GetArrayLength();
            double tot = 0;
            foreach (var gp in gps.EnumerateArray())
                if (gp.ValueKind == JsonValueKind.Object && gp.TryGetProperty("gap_min", out var gm) && gm.ValueKind == JsonValueKind.Number) tot += gm.GetDouble();
            notes.Add(string.Format(L["{0} recording gap(s) totalling {1} min interrupt the recording; the trends are not continuous across them."], ng, tot.ToString("0.#", inv)));
        }
        return notes;
    }

    private static string ErrorHint(string? e)
    {
        var t = (e ?? "").ToLowerInvariant();
        if (t.Contains("edf")) return "Make sure the folder contains .edf files exported from the monitor. Other formats are not supported.";
        if (t.Contains("sampling") || t.Contains("rate")) return "The files have different sampling rates. Use files from one continuous recording.";
        if (t.Contains("qc") || t.Contains("nothing to analyze") || t.Contains("valid window")) return "The signal did not pass quality control (too flat, saturated, or noisy). Check the channel and the recording quality.";
        if (t.Contains("composite") || t.Contains("long enough")) return "The recording is too short for a full-session composite. Use a longer recording or Single-file review.";
        if (t.Contains("window")) return "The manual window falls outside the recorded data. Adjust the start and end times.";
        return "Check that the files are valid EDF exports from the monitor and try again.";
    }

    private async Task PrintReportAsync()
    {
        try { await JS.InvokeVoidAsync("nmwPrint"); } catch { }
    }

    private async Task DownloadCsvAsync()
    {
        if (_raw is not { } raw) return;
        var csv = BuildCsv(raw);
        var date = TryClock(raw, "session_start", out var dt)
            ? dt.ToString("yyyyMMdd", CultureInfo.InvariantCulture)
            : DateTime.UtcNow.ToString("yyyyMMdd", CultureInfo.InvariantCulture);
        try { await JS.InvokeVoidAsync("nmwDownload", $"NeuralMetric_{date}_data.csv", csv, "text/csv"); } catch { }
    }

    private static string BuildCsv(JsonElement raw)
    {
        // Wide layout: one header row + one data row (one session per row) for
        // direct append in Excel / import in SPSS. Only Date, times, duration,
        // biomarkers and BSR.
        var inv = CultureInfo.InvariantCulture;
        string Num(JsonElement e, string k, string fmt) =>
            e.TryGetProperty(k, out var v) && v.ValueKind == JsonValueKind.Number ? v.GetDouble().ToString(fmt, inv) : "";

        string date = TryClock(raw, "session_start", out var ds) ? ds.ToString("yyyy-MM-dd", inv) : "";
        string tStart = TryClock(raw, "session_start", out var a2) ? a2.ToString("HH:mm:ss", inv) : "";
        string tEnd = TryClock(raw, "session_end", out var b2) ? b2.ToString("HH:mm:ss", inv) : "";
        string dur = (ds != default && b2 != default && b2 > ds) ? (b2 - ds).TotalMinutes.ToString("0.0", inv) : "";

        string bsrPct = "", suppMin = "", longest = "", indet = "";
        if (raw.TryGetProperty("bsr", out var bsr) && bsr.ValueKind == JsonValueKind.Object)
        {
            bsrPct = Num(bsr, "bsr_pct", "0.###");
            suppMin = Num(bsr, "suppression_min", "0.##");
            longest = Num(bsr, "episode_longest_s", "0.##");
            indet = Num(bsr, "indeterminate_pct", "0.###");
        }

        var cols = new[] { "Date", "TimeStart", "TimeEnd", "Duration_min",
            "Delta_uV2", "Delta_pct", "Theta_uV2", "Theta_pct", "Alpha_uV2", "Alpha_pct",
            "Beta_uV2", "Beta_pct", "Total_uV2", "SEF95_Hz",
            "BSR_pct", "Suppression_min", "LongestEpisode_s", "Indeterminate_pct" };
        var vals = new[] { date, tStart, tEnd, dur,
            Num(raw, "delta_uv2", "0.####"), Num(raw, "delta_pct", "0.##"),
            Num(raw, "theta_uv2", "0.####"), Num(raw, "theta_pct", "0.##"),
            Num(raw, "alpha_uv2", "0.####"), Num(raw, "alpha_pct", "0.##"),
            Num(raw, "beta_uv2", "0.####"), Num(raw, "beta_pct", "0.##"),
            Num(raw, "total_uv2", "0.####"), Num(raw, "sef95_hz", "0.##"),
            bsrPct, suppMin, longest, indet };

        static string E(string x) => (x.Contains(',') || x.Contains('"') || x.Contains('\n'))
            ? "\"" + x.Replace("\"", "\"\"") + "\"" : x;
        var sb = new System.Text.StringBuilder();
        sb.Append(string.Join(",", System.Linq.Enumerable.Select(cols, E))).Append("\r\n");
        sb.Append(string.Join(",", System.Linq.Enumerable.Select(vals, E))).Append("\r\n");
        return sb.ToString();
    }

    private bool IsFirst(string k) => _order.IndexOf(k) <= 0;
    private bool IsLast(string k) => _order.IndexOf(k) == _order.Count - 1;
    private void MoveUp(string k) { int i = _order.IndexOf(k); if (i > 0) { (_order[i - 1], _order[i]) = (_order[i], _order[i - 1]); SaveOrder(); } }
    private void MoveDown(string k) { int i = _order.IndexOf(k); if (i >= 0 && i < _order.Count - 1) { (_order[i + 1], _order[i]) = (_order[i], _order[i + 1]); SaveOrder(); } }
    private void SaveOrder() { _ = _charts?.InvokeVoidAsync("saveOrder", string.Join(",", _order)); }

    private async Task DrawBandTrendAsync()
    {
        if (_raw is not { } raw || !raw.TryGetProperty("band_trend", out var bt) || bt.ValueKind != JsonValueKind.Object) return;
        _charts ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/charts.js");
        try
        {
            await _charts.InvokeVoidAsync("renderBandTrend", "chart-psd", bt,
                new { mode = _psdMode, xMax = _sharedX, rightPad = 70,
                      labels = new { x = L["time (min)"], yDb = L["dB (absolute band power)"], yRel = L["% of total"] } });
        }
        catch { }
    }

    private void OnStage(string stage)
    {
        _stage = stage switch { "reading" => 1, "processing" => 2, "done" => 3, _ => _stage };
        InvokeAsync(StateHasChanged);
    }

    private void StartTick()
    {
        StopTick();
        _tickCts = new CancellationTokenSource();
        _ = RunTickAsync(_tickCts.Token);
    }

    private async Task RunTickAsync(CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(200));
            while (await timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private void StopTick()
    {
        _tickCts?.Cancel();
        _tickCts?.Dispose();
        _tickCts = null;
    }

    public void Dispose()
    {
        StopTick();
        L.OnChange -= Render;
        _selfRef?.Dispose();
        _ = _charts?.DisposeAsync();
    }

    private string StepClass(int i) =>
        _stage > i ? "done" : (_stage == i ? (_stage == 3 ? "done" : "active") : "pending");

    private string RuntimeText => (_stage == 3 ? $"{L["Analysis runtime"]}: " : "") + ElapsedText;

    private string ElapsedText
    {
        get
        {
            var e = _sw.Elapsed;
            var inv = CultureInfo.InvariantCulture;
            return e.TotalSeconds < 60
                ? $"{e.TotalSeconds.ToString("0.0", inv)} s"
                : $"{(int)e.TotalMinutes}:{e.Seconds.ToString("00", inv)} min";
        }
    }

    private static string Text(JsonElement e, string name) =>
        e.TryGetProperty(name, out var v) && v.ValueKind != JsonValueKind.Null ? v.ToString() : "—";

    private static IEnumerable<string> Strings(JsonElement e, string name) =>
        e.TryGetProperty(name, out var arr) && arr.ValueKind == JsonValueKind.Array
            ? arr.EnumerateArray().Select(x => x.GetString() ?? "")
            : Enumerable.Empty<string>();

    private static bool HasCompositeTrend(JsonElement raw) =>
        raw.TryGetProperty("maintenance", out var m)
            && m.TryGetProperty("composite_trend", out var t)
            && t.ValueKind == JsonValueKind.Object;

    private static bool HasDsa(JsonElement raw) =>
        raw.TryGetProperty("dsa", out var d) && d.ValueKind == JsonValueKind.Object;

    private static bool HasBandTrend(JsonElement raw) =>
        raw.TryGetProperty("band_trend", out var p) && p.ValueKind == JsonValueKind.Object;

    private static bool HasBsr(JsonElement raw) =>
        raw.TryGetProperty("bsr_trend", out var bt) && bt.ValueKind == JsonValueKind.Object
        && bt.TryGetProperty("time_min", out var tm) && tm.ValueKind == JsonValueKind.Array && tm.GetArrayLength() > 0;

    private static string VerdictClass(JsonElement e) =>
        Text(e, "verdict") is "complete" or "manual" or "review" ? "ok" : "danger";

    private static string WindowText(JsonElement m) =>
        m.TryGetProperty("window", out var w) && w.ValueKind == JsonValueKind.Array && w.GetArrayLength() == 2
            ? $"{w[0].GetDouble().ToString("0.0", CultureInfo.InvariantCulture)} – " +
              $"{w[1].GetDouble().ToString("0.0", CultureInfo.InvariantCulture)} min"
            : "—";

    private string DateText(JsonElement e, string name) =>
        TryClock(e, name, out var dt) ? dt.ToString("d", L.Culture) : "—";

    private static string TimeText(JsonElement e, string name) =>
        TryClock(e, name, out var dt) ? dt.ToString("HH:mm", CultureInfo.InvariantCulture) : "—";

    private string SpanText(JsonElement e, string startName, string endName)
    {
        if (TryClock(e, startName, out var a) && TryClock(e, endName, out var b) && b > a)
        {
            var mins = (b - a).TotalMinutes;
            var inv = CultureInfo.InvariantCulture;
            return $"{mins.ToString("0.0", inv)} {L["min"]} ({(mins / 60).ToString("0.0", inv)} {L["hrs"]})";
        }
        return "—";
    }

    private static bool TryClock(JsonElement e, string name, out DateTime dt)
    {
        dt = default;
        return e.TryGetProperty(name, out var v)
            && v.ValueKind == JsonValueKind.String
            && DateTimeOffset.TryParse(v.GetString(), CultureInfo.InvariantCulture,
                   DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal, out var dto)
            && (dt = dto.UtcDateTime) != default;
    }
}
